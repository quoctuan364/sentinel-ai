# ==============================================================================
# Sentinel AI Environment Configuration Template
# ==============================================================================

# Application & Security
PROJECT_NAME="Sentinel AI"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="replace-with-a-strong-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALLOW_DEV_FALLBACK_AUTH=false

# Database Configuration
# Default to SQLite local database for instant zero-dependency execution:
DATABASE_URL="sqlite+aiosqlite:///./sentinel.db"
# Or PostgreSQL in Docker / Production:
# DATABASE_URL="postgresql+asyncpg://sentinel:replace_with_secure_password@localhost:5432/sentinel_db"

# Redis Task Broker (optional for local, used for distributed workers in prod)
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED=false

# GitHub App Integration
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET="replace-with-your-github-webhook-secret"

# AI Triage Engine (deterministic mock provider or OpenAI)
AI_ENABLED=true
AI_PROVIDER="mock"  # "mock" or "openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
AI_MONTHLY_BUDGET_CENTS_DEFAULT=5000

# Security Scan Limits
MAX_DIFF_FILE_COUNT=100
MAX_DIFF_LINE_COUNT=15000
MAX_FILE_SIZE_BYTES=5242880
SCAN_TIMEOUT_SECONDS=180

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
